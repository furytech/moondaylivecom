{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/Transits/:slug", "destination": "/blog/transits/:slug", "permanent": true },
    { "source": "/blog/Guides/:slug", "destination": "/blog/guides/:slug", "permanent": true },
    { "source": "/blog/Features/:slug", "destination": "/blog/features/:slug", "permanent": true },
    { "source": "/blog/Product%20Updates/:slug", "destination": "/blog/product-updates/:slug", "permanent": true },
    { "source": "/blog/Product-Updates/:slug", "destination": "/blog/product-updates/:slug", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/library/:slug([a-z]+-moon)",
      "destination": "/library/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app"
    }
  ]
}
